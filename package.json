{
  "name": "typing-practice-backend",
  "version": "1.0.0",
  "description": "Serverless backend for typing practice application",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "serverless offline start --stage dev",
    "deploy:dev": "npm run deploy:infrastructure:dev && npm run deploy:functions:dev",
    "deploy:staging": "npm run deploy:infrastructure:staging && npm run deploy:functions:staging",
    "deploy:prod": "npm run deploy:infrastructure:prod && npm run deploy:functions:prod",
    "deploy:infrastructure:dev": "serverless deploy --config serverless-infrastructure.yml --stage dev",
    "deploy:infrastructure:staging": "serverless deploy --config serverless-infrastructure.yml --stage staging",
    "deploy:infrastructure:prod": "serverless deploy --config serverless-infrastructure.yml --stage prod",
    "deploy:functions:dev": "npm run build && serverless deploy --stage dev",
    "deploy:functions:staging": "npm run build && serverless deploy --stage staging",
    "deploy:functions:prod": "npm run build && serverless deploy --stage prod",
    "remove": "serverless remove",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "seed": "ts-node scripts/seed-data.ts"
  },
  "keywords": [
    "serverless",
    "aws",
    "lambda",
    "typescript",
    "typing",
    "practice"
  ],
  "author": "Siddhesh Alagade",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@google/generative-ai": "^0.2.0",
    "aws-jwt-verify": "^4.0.0",
    "joi": "^17.0.0",
    "serverless-typescript": "^0.0.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "serverless": "^3.0.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^12.0.0",
    "serverless-plugin-typescript": "^2.1.5",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^4.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
